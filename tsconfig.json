{
  "include": ["src/index.ts"],
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "strict": false,
    "esModuleInterop": true,
    "noImplicitAny": false,
    "moduleResolution": "bundler",
    "rootDir": "src",
    "outDir": "dist"
  }
}
