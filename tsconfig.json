{
  "include": ["src/index.ts", "src/**/*.ts", "src/**/*.tsx"],
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "target": "ES6",
    "esModuleInterop": true,
    "noImplicitAny": false,
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "./src",
    "ignoreDeprecations": "6.0",
    "jsx": "react-jsx"
  }
}
